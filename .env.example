# Run npm run setup to generate the local encryption key. Never commit .env.
DATABASE_URL="file:./data/grant.db"
APP_URL="http://localhost:3000"
CREDENTIAL_ENCRYPTION_KEY=""
# Optional environment overrides. Otherwise use encrypted Settings fields.
MAILBOX_USER=""
MAILBOX_PASSWORD=""
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURITY="TLS"
IMAP_HOST="imap.hostinger.com"
IMAP_PORT="993"
# Public HTTPS origin of YOUR deployed Worker; leave empty to disable.
TRACKING_BASE_URL=""
TRACKING_SYNC_SECRET=""
# Restrict Worker origin changes to this configuration, never browser input.
# Credentials are entered in Settings; there is no default owner password.
