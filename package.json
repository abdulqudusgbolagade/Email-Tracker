{
  "name": "grant-mail-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "workers/tracking"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,jobs \"next dev --hostname 127.0.0.1\" \"tsx watch --env-file=.env scripts/runner.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "concurrently -k -n web,jobs \"next start --hostname 127.0.0.1\" \"tsx --env-file=.env scripts/runner.ts\"",
    "start:web": "next start --hostname 127.0.0.1",
    "jobs": "tsx --env-file=.env scripts/runner.ts",
    "setup": "tsx scripts/setup.ts",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "test": "vitest run && npm run test --workspace=@grant/tracking",
    "test:app": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspace=@grant/tracking",
    "lint": "eslint src scripts tests workers/tracking/src",
    "postinstall": "node scripts/prisma.mjs generate",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "cf": "node scripts/cloudflare.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-sqlite3": "12.6.0",
    "concurrently": "10.0.6",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "18.0.9",
    "imapflow": "2.9.1",
    "lucide-react": "1.61.0",
    "mailparser": "3.12.4",
    "next": "16.4.2",
    "nodemailer": "10.2.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/smtp-server": "3.5.13",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "prettier": "3.6.2",
    "smtp-server": "3.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.152.0"
  }
}
